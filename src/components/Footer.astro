---
// Rodapé de todas as páginas: o rodapé padrão do Starlight + os itens do menu lateral.
// A lista vem do próprio menu, então áreas e páginas novas aparecem aqui sozinhas.
import Padrao from '@astrojs/starlight/components/Footer.astro';

const { sidebar } = Astro.locals.starlightRoute;

type Item = (typeof sidebar)[number];
type Link = Extract<Item, { type: 'link' }>;

// Subpastas de uma área entram na mesma coluna.
const paginas = (item: Item): Link[] =>
  item.type === 'link' ? [item] : item.entries.flatMap(paginas);
---

<Padrao><slot /></Padrao>

{/* data-pagefind-ignore: sem isso, o menu entraria na busca de todas as páginas */}
<nav class="mapa-site" aria-label="Mapa do site" data-pagefind-ignore>
  {
    sidebar.map((item) =>
      item.type === 'link' ? (
        <a class="titulo" href={item.href} aria-current={item.isCurrent ? 'page' : undefined}>
          {item.label}
        </a>
      ) : (
        <div>
          <p class="titulo">{item.label}</p>
          <ul>
            {paginas(item).map((link) => (
              <li>
                <a href={link.href} aria-current={link.isCurrent ? 'page' : undefined}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    )
  }
</nav>

<style>
  .mapa-site {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: 1.5rem 2rem;
    align-items: start;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--sl-color-hairline-light);
    font-size: var(--sl-text-sm);
  }
  .titulo {
    margin: 0;
    font-weight: 600;
    color: var(--sl-color-white);
    text-decoration: none;
  }
  ul {
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
  }
  li a {
    display: block;
    padding-block: 0.2rem;
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }
  a:hover,
  a[aria-current='page'] {
    color: var(--sl-color-text-accent);
  }
</style>
